{
  "schemaVersion": 1,
  "id": "idontcare",
  "version": "${version}",
  "name": "I Don't Care",
  "description": "Simple Mod that adds a 'Don't show again' checkbox to world backup and confirmation popups with seamless vanilla styling, per-world persistence, and Mod Menu configuration.",
  "authors": [
    "RO4449"
  ],
  "contact": {
    "sources": "https://github.com/RO4449/i-dont-care"
  },
  "license": "MIT",
  "icon": "assets/idontcare/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.ro4449.idontcare.IDontCareClient"
    ],
    "modmenu": [
      "com.ro4449.idontcare.compat.modmenu.ModMenuIntegration"
    ]
  },
  "mixins": [
    "idontcare.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": ">=1.21",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "*"
  }
}
